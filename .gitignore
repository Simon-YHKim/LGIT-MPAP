# LGIT-MPAP root .gitignore
# (streamlit-app/.gitignore 는 별도 — 그 안에서 .streamlit/secrets.toml 등 정책 관리)

# make_handoff_zip.sh 출력
dist/
*.zip

# Python 캐시
__pycache__/
*.pyc
*.pyo

# 가상환경
.venv/
venv/
env/

# IDE / 에디터
.idea/
.vscode/
*.swp
*~

# OS 메타
.DS_Store
Thumbs.db

# 로컬 빌드/테스트 산출물
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
