# =====================================================================
# secrets.toml — 템플릿 (실 운영 시 .streamlit/secrets.toml 으로 복사)
# =====================================================================
# 실제 secrets.toml 은 .gitignore 에 추가해 깃 추적 제외 권장.
# 폐쇄망 운영 환경에선 노출 위험 낮으나, 만약 깃허브 PUBLIC 으로
# 가시성이 있다면 즉시 비밀번호 회전 + force-push 히스토리 정리 필요.
# =====================================================================

[db]
host     = "your-db-host"
name     = "your-db-name"
user     = "your-db-user"
password = "REPLACE_ME"
port     = 5432

[cookie]
password = "GENERATE_RANDOM_64_CHAR_STRING"

# 추가 비밀이 있으면 여기에 추가 (LLM API key 등)
# [llm]
# api_key = "REPLACE_ME"
